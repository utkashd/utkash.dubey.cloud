{
    "editor.formatOnSave": true,
    "editor.rulers": [121],
    "editor.tabSize": 4,
    "eslint.options": {
        "overrideConfigFile": "config/eslint.config.js"
    },
    "prettier.configPath": "config/prettier.config.js",
    "prettier.ignorePath": "config/.prettierignore",
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "rewrap.autoWrap.enabled": true
    },
    "markdownlint.configFile": "config/.markdownlint.jsonc",
    "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][jsonl]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "evenBetterToml.taplo.configFile.path": "config/.taplo.toml",
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml",
        "editor.rulers": [80]
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/node_modules/": true,
        "**/.tanstack/": true,
        "**/dist/": true,
        "**/routeTree.gen.ts": true,
        "**/.pnpm-store/": true
    },
    "files.watcherExclude": {
        "**/routeTree.gen.ts": true
    },
    "search.exclude": {
        "**/routeTree.gen.ts": true,
        "**/pnpm-lock.yaml": true
    },
    "files.readonlyInclude": {
        "**/routeTree.gen.ts": true
    }
}
